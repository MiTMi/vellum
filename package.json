{
  "name": "vellum",
  "productName": "Vellum",
  "version": "1.0.0",
  "description": "A beautiful personal workspace — pages, databases, and notes, powered by Convex.",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Michael Touboul",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n convex,vite,app -c cyan,magenta,green \"convex dev\" \"vite\" \"npm:electron:dev\"",
    "dev:web": "concurrently -k -n convex,vite -c cyan,magenta \"convex dev\" \"vite\"",
    "electron:dev": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173/app.html electron .",
    "build": "tsc --noEmit && vite build",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --mac",
    "convex:deploy": "convex deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@convex-dev/auth": "^0.0.95",
    "@floating-ui/react": "^0.27.18",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "convex": "^1.46.0",
    "emoji-picker-react": "^4.22.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.59",
    "cross-env": "^10.1.0",
    "electron": "^43.7.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.michael.vellum",
    "productName": "Vellum",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    }
  }
}
