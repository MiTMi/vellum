# Production Convex deployment. Checked in on purpose — these are public
# endpoints, not secrets, and Vite needs them at build time.
#
# Vite loads env files in the order .env → .env.local → .env.[mode], so in
# ANY build (`npm run build`, `npm run dist`, Vercel) this file wins over the
# gitignored .env.local. That means every local `vite build` now targets prod,
# by design: the packaged Mac app and the hosted web app must talk to the same
# backend. `npm run dev` / `npm run dev:web` still use .env.local → dev.
# EU West (Ireland), same region as the dev deployment — a US-hosted backend
# would have put a transatlantic hop on every sync round-trip.
VITE_CONVEX_URL=https://gregarious-schnauzer-219.eu-west-1.convex.cloud

# Origin that published /p/<slug> links are minted from. The Vercel domain,
# not the .convex.site one — vercel.json proxies /p/* through to Convex, so
# shared links live on the app's own domain.
#
# Note this is NOT VITE_CONVEX_SITE_URL. `npx convex deploy --cmd` injects
# that name into the build environment (derived from the deployment), and a
# real process env var outranks .env.production in Vite — so setting it here
# works locally and is silently reverted on every Vercel build.
#
# Must be Vercel's stable production alias, never the per-deployment URL
# (vellum-<hash>-<scope>.vercel.app), which changes on every push.
VITE_PUBLIC_SITE_URL=https://vellum-gilt.vercel.app
